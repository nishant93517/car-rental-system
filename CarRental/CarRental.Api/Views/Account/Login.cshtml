@model CarRental.Api.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · Car Rental</title>
    <style>
        * { box-sizing: border-box; }
        body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 1rem; font-family: Segoe UI, Arial, sans-serif; color: #172033; background: linear-gradient(135deg, #eaf3f8, #f5f7fb); }
        .card { width: min(100%, 420px); padding: 2rem; border: 1px solid #e1e8f0; border-radius: 16px; background: #fff; box-shadow: 0 18px 50px #112d4e18; }
        h1 { margin: 0 0 .4rem; }
        p { color: #64748b; }
        label { display: block; margin: 1rem 0 .4rem; font-weight: 600; }
        input[type=email], input[type=password] { width: 100%; padding: .75rem; border: 1px solid #cbd5e1; border-radius: 8px; font: inherit; }
        button { width: 100%; margin-top: 1.25rem; padding: .8rem; border: 0; border-radius: 8px; color: white; background: #176b87; font: inherit; font-weight: 700; cursor: pointer; }
        .error { color: #b91c1c; }
        .remember { display: flex; gap: .5rem; align-items: center; margin-top: 1rem; }
    </style>
</head>
<body>
    <main class="card">
        <h1>Welcome back</h1>
        <p>Sign in to manage the car rental fleet.</p>
        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="username" required />
            <span asp-validation-for="Email" class="error"></span>
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" autocomplete="current-password" required />
            <span asp-validation-for="Password" class="error"></span>
            <label class="remember"><input asp-for="RememberMe" /> Remember me</label>
            <button type="submit">Sign in</button>
        </form>
        <p>New member? <a href="/Account/Register">Create an account</a></p>
    </main>
</body>
</html>