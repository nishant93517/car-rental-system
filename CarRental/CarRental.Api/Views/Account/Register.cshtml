@model CarRental.Api.Models.RegisterViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Create account · Car Rental</title>
    <style>
        * { box-sizing: border-box; }
        body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 1rem; font-family: Segoe UI, Arial, sans-serif; color: #172033; background: linear-gradient(135deg, #eaf3f8, #f5f7fb); }
        .card { width: min(100%, 440px); padding: 2rem; border: 1px solid #e1e8f0; border-radius: 16px; background: #fff; box-shadow: 0 18px 50px #112d4e18; }
        h1 { margin: 0 0 .4rem; }
        p { color: #64748b; }
        label { display: block; margin: 1rem 0 .4rem; font-weight: 600; }
        input[type=email], input[type=password] { width: 100%; padding: .75rem; border: 1px solid #cbd5e1; border-radius: 8px; font: inherit; }
        button { width: 100%; margin-top: 1.25rem; padding: .8rem; border: 0; border-radius: 8px; color: white; background: #176b87; font: inherit; font-weight: 700; cursor: pointer; }
        .error { color: #b91c1c; }
    </style>
</head>
<body>
    <main class="card">
        <h1>Create your account</h1>
        <p>Register as a member to browse the car fleet.</p>
        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="username" required />
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" autocomplete="new-password" minlength="12" required />
            <label asp-for="ConfirmPassword">Confirm password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
            <p>Password must be at least 12 characters and include uppercase, lowercase, a number, and a symbol.</p>
            <button type="submit">Create account</button>
        </form>
        <p>Already registered? <a href="/Account/Login">Sign in</a></p>
    </main>
</body>
</html>